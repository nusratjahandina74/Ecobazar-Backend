# --- required ---
PORT=5000
MONGODB_URL=mongodb+srv://<user>:<password>@<cluster>/<db>
ACCESS_TOKEN_SECRET=<long-random-string>

# --- URLs (used in e-mails and payment redirects) ---
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:5000

# --- optional ---
ACCESS_TOKEN_EXPIRES=1d
AAMARPAY_STORE_ID=aamarpaytest
AAMARPAY_SIGNATURE_KEY=<your-aamarpay-signature-key>
AAMARPAY_API_URL=https://sandbox.aamarpay.com/jsonpost.php
# AAMARPAY_VERIFY_URL=<aamarpay transaction-verification endpoint>

# set to "production" on a live server (enables strict login/registration rate limits, hides error details)
# NODE_ENV=production
